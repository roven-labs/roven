{
  "$schema": "https://aka.ms/codetour-schema",
  "title": "PMEMC Command and Inspection Flow",
  "description": "A feature-explainer tour of how PMEMC turns PowerShell commands into Git evidence, OpenRouter proposals, review decisions, and verified project memory.",
  "ref": "worktree",
  "steps": [
    {
      "file": "src/main.rs",
      "line": 1,
      "title": "Process Entry Point",
      "description": "The binary calls pmemc::run(), prints a safe error, and exits nonzero on failure. This keeps the executable thin and makes command behavior testable in the library crate."
    },
    {
      "file": "src/lib.rs",
      "line": 23,
      "title": "CLI Dispatch Boundary",
      "description": "run() parses the Clap command and delegates to commands::run(). No provider or repository work happens before this boundary."
    },
    {
      "file": "src/commands/mod.rs",
      "line": 14,
      "title": "Top-Level Command Router",
      "description": "The command router initializes local storage for init and delegates project, status, inspect, review, history, and auth commands to small handlers. Project names are resolved here before numeric IDs are used internally."
    },
    {
      "file": "src/commands/project.rs",
      "line": 17,
      "title": "Project Registration",
      "description": "project add asks Git for repository metadata, derives the directory name such as medlink-ddi, and stores the canonical path, branch, and HEAD without reading source files."
    },
    {
      "file": "src/storage.rs",
      "line": 542,
      "title": "SQLite Initialization",
      "description": "initialize creates the PMEMC local directories and applies migrations transactionally. add_project then stores the registered repository and its lifecycle state."
    },
    {
      "file": "src/commands/status.rs",
      "line": 8,
      "title": "Read-Only Status",
      "description": "status resolves the project, reads Git metadata and porcelain status, compares it with the approved baseline, and prints changes. It does not inspect source or call OpenRouter."
    },
    {
      "file": "src/commands/inspect.rs",
      "line": 7,
      "title": "Inspection Approval Gate",
      "description": "inspect displays the scope and waits for y/yes. A denial stops before source reads. Approval either retries a retained failed bundle or builds a new package, then verifies the repository did not change during inspection."
    },
    {
      "file": "src/inspection.rs",
      "line": 89,
      "title": "Evidence Package",
      "description": "Initial inspection builds a structural map and selects supported files; incremental inspection selects changed files and structural neighbors. Content is bounded and suspected secrets are redacted before provider use."
    },
    {
      "file": "src/code_map.rs",
      "line": 96,
      "title": "Structural Code Map",
      "description": "Tree-sitter-based extraction records files, symbols, imports, and only unambiguous relationships. The map helps choose evidence; it is not treated as verified project memory."
    },
    {
      "file": "src/application.rs",
      "line": 30,
      "title": "Provider Workflow",
      "description": "submit_staged_bundle invokes the provider after the approved bundle is staged. Failures retain a retryable attempt; successful responses continue only after provider validation."
    },
    {
      "file": "src/provider.rs",
      "line": 371,
      "title": "OpenRouter Adapter",
      "description": "OpenRouterProvider reads the OS credential, sends the bounded structured-output request, validates the response against the exact evidence bundle, and records the concrete model selected by openrouter/free."
    },
    {
      "file": "src/storage.rs",
      "line": 1563,
      "title": "Pending Review Persistence",
      "description": "store_provider_response transactionally stores provider metadata, proposals, questions, evidence links, and conflicts as pending review. It cannot directly create verified facts."
    },
    {
      "file": "src/commands/review.rs",
      "line": 100,
      "title": "Human Review",
      "description": "review presents each proposal and evidence, then accepts, corrects, rejects, or skips it. The model's claim remains untrusted until the operator records a decision."
    },
    {
      "file": "src/storage.rs",
      "line": 1207,
      "title": "Atomic Finalization",
      "description": "After required decisions are complete, finalize_review atomically writes verified facts, evidence, decisions, the code-map snapshot, and the new baseline. This is why your command ended with 'finalized inspection 1 with 11 verified facts'."
    },
    {
      "file": "src/commands/auth.rs",
      "line": 7,
      "title": "Credential Commands",
      "description": "auth set/status/remove manage the OpenRouter credential without printing it. Normal inspection resolves Windows Credential Manager first and uses OPENROUTER_API_KEY only as a runtime fallback."
    },
    {
      "title": "Operational Next Step",
      "description": "Use project show medlink-ddi to inspect verified facts and evidence counts, status medlink-ddi to see changes, inspect medlink-ddi to create another proposal set, and review medlink-ddi to approve the next set."
    }
  ]
}
